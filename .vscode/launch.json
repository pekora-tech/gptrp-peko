{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Agent Server",
      "runtimeExecutable": "nodemon",
      "restart": true,
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}/agent",
      "program": "${workspaceFolder}/agent/index.js"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "UI Admin (React)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["start"],
      "cwd": "${workspaceFolder}/ui-admin",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    }
  ],
  "compounds": [
    {
      "name": "Start All (Agent + UI)",
      "configurations": ["Agent Server", "UI Admin (React)"],
      "stopAll": true,
      "preLaunchTask": null
    }
  ]
}
