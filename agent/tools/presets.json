[
  {
    "name": "goto_bed",
    "description": "Navigate to bed location and sleep until fully rested",
    "category": "survival",
    "version": "1.0.0",
    "preconditions": [
      {
        "type": "state_check",
        "field": "sleepiness",
        "operator": ">",
        "value": 5
      },
      {
        "type": "location_known",
        "resource": "bed"
      }
    ],
    "steps": [
      {
        "type": "find_location",
        "description": "Find bed location from memory",
        "params": {
          "resource": "bed"
        }
      },
      {
        "type": "navigate",
        "description": "Navigate to bed location",
        "params": {
          "useResult": 0,
          "timeout": 30000
        },
        "onFailure": "call_ai",
        "retryable": true
      },
      {
        "type": "action",
        "description": "Execute sleep action",
        "params": {
          "actionType": "sleep"
        }
      },
      {
        "type": "wait",
        "description": "Wait for sleep to take effect",
        "params": {
          "duration": 2000
        }
      }
    ],
    "expected_outcome": {
      "description": "Sleepiness reduced to near zero",
      "state_changes": [
        {
          "field": "sleepiness",
          "operator": "<=",
          "value": 1
        }
      ]
    },
    "created_by": "system"
  },
